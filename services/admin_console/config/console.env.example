# Admin Console v6 默认配置
# 复制为 console.env 并按需修改（不要提交真实密钥）

# ── 控制台服务 ──
CONSOLE_PORT=9000
CONSOLE_HOST=127.0.0.1

# ── 服务与应用路径 ──
# 应用基准目录（数据、日志、Python 代码的根目录）
APP_BASE=/opt

# 各服务子目录（留空则使用 $APP_BASE/<服务名>）
SURVEY_APP_DIR=/opt/sjtu_survey_pro
DIET_APP_DIR=/opt/diet_survey
EXERCISE_APP_DIR=/opt/exercise_survey

# ── 数据库 ──
# 留空则由控制台根据服务目录自动探测
# SURVEY_DB=/opt/sjtu_survey_pro/survey_data.db
# DIET_DB=/opt/diet_survey/diet_data.db
# EXERCISE_DB=/opt/exercise_survey/exercise_data.db

# ── SMTP ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_ADMIN_EMAIL=

# ── LLM ──
# 主 API（OpenAI 兼容）
LLM_BASE_URL=
LLM_MODEL_NAME=
# 逗号分隔，支持轮换
LLM_API_KEYS=
# 备用 API
LLM_BACKUP_BASE_URL=
LLM_BACKUP_MODEL_NAME=
LLM_BACKUP_API_KEY=

# ── 安全 ──
# 控制台管理口令（首次安装可留空，安装时提示设置）
# CONSOLE_PASSWORD=

# ── Nginx ──
NGINX_SITES_DIR=/etc/nginx/sites-available
NGINX_ENABLED_DIR=/etc/nginx/sites-enabled
