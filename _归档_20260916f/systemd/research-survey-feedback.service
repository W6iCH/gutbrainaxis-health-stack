# ============================================================================
#  systemd 单元模板
#  占位符由 install.sh 自动替换：
#    __APP_BASE__   → 安装前缀（默认 /opt/gutbrainaxis）
#    __VENV__       → venv 的 python3 绝对路径
#    __ENV_FILE__   → 环境变量文件（默认 /etc/research-app/env）
#    __SERVICE_USER__ → 运行用户（默认 root）
#  ⚠️ 不要直接拷到 /etc/systemd/system/，请用 install.sh 安装。
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
#  1) 问卷反馈页面   :8000  (+ :8080 兼容监听)
# ────────────────────────────────────────────────────────────────────────────
[Unit]
Description=Research Survey Feedback Server (:8000)
Documentation=file://__APP_BASE__/docs/常见故障排查.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__APP_BASE__/sjtu_survey_pro
EnvironmentFile=-__ENV_FILE__
ExecStart=__VENV__ __APP_BASE__/sjtu_survey_pro/feedback_server.py 8000 8080
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=research-survey-feedback

[Install]
WantedBy=multi-user.target
