# ────────────────────────────────────────────────────────────────────────────
#  rclone 备份定时器 — 每天凌晨 3:00 触发
# ────────────────────────────────────────────────────────────────────────────
[Unit]
Description=Research Rclone Backup Timer (daily at 3am)
Documentation=file://__APP_BASE__/docs/升级备份与回滚.md

[Timer]
OnCalendar=daily
OnCalendar=*-*-* 03:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
