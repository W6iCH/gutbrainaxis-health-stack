# ============================================================================
#  个性化饮食干预课题 — 服务器端研究系统  环境变量配置模板
# ============================================================================
#  用法：
#    1. 安装脚本会自动复制到 /etc/research-app/env
#    2. 填写所有 <...> 占位符（或 __CHANGE_ME__）
#    3. 收紧权限：  sudo chmod 600 /etc/research-app/env
#    4. 重启服务：  sudo systemctl restart research-*
#
#  ⚠️ 本文件不得写入真实密钥。真实配置只存在于 /etc/research-app/env（0600）。
# ============================================================================

# ── 安装位置 ────────────────────────────────────────────────────────────────
# 必填。安装前缀。默认 /opt/gutbrainaxis（与原服务器一致）。
APP_BASE=/opt/gutbrainaxis

# 各服务目录（留空则默认 $APP_BASE/sjtu_survey_pro 等）
SURVEY_APP_DIR=/opt/gutbrainaxis/sjtu_survey_pro
DIET_APP_DIR=/opt/gutbrainaxis/diet_survey
EXERCISE_APP_DIR=/opt/gutbrainaxis/exercise_survey

# 数据库位置（留空则由各服务根据自身目录推导）
# SURVEY_DB=/opt/gutbrainaxis/sjtu_survey_pro/survey_data.db
# DIET_DB=/opt/gutbrainaxis/diet_survey/diet_data.db
# ROSTER_PATH=/opt/gutbrainaxis/data_dashboard/roster.json

# ══════════════════════════════════════════════════════════════════════════
#  一、SMTP 邮件（问卷反馈 / 饮食反馈 / 每日报告 共用）
# ══════════════════════════════════════════════════════════════════════════
# 直接投递 MX（25 端口，明文/STARTTLS）
# 必填。MX 服务器地址（留空则尝试用 SSL 配置）。
SMTP_HOST=mail.sjtu.edu.cn
# 可选。SMTP 端口。默认 25。
SMTP_PORT=25
# 认证投递（465 端口，SSL）；若用 MX 直投可留空
# 可选。SSL SMTP 服务器地址。
SMTP_SSL_HOST=mail.sjtu.edu.cn
# 可选。SSL SMTP 端口。默认 465。
SMTP_SSL_PORT=465

# 必填。SMTP 用户名（通常与发件人邮箱相同）。
SMTP_USERNAME=<SMTP_USERNAME>
# 必填。SMTP 密码或专用密码。
SMTP_PASSWORD=__CHANGE_ME__

# 发件人
# 必填。发件人邮箱地址。
SMTP_SENDER_EMAIL=<SENDER_EMAIL>
# 可选。发件人显示名称。
SMTP_SENDER_NAME=Research Feedback System

# 管理员邮箱：失败通知 / 每日报告 / 监控告警的收件人
# 必填。
SMTP_ADMIN_EMAIL=<ADMIN_EMAIL>

# ══════════════════════════════════════════════════════════════════════════
#  二、告警邮件（send_alert.py / health_monitor.py 专用）
# ══════════════════════════════════════════════════════════════════════════
# 必填。告警 SMTP 服务器地址（可与上面相同）。
ALERT_SMTP_HOST=mail.sjtu.edu.cn
# 必填。告警 SMTP 端口。默认 465。
ALERT_SMTP_PORT=465
# 必填。告警 SMTP 用户名（通常与 ALERT_FROM 相同）。
ALERT_SMTP_USERNAME=<ALERT_SMTP_USERNAME>
# 必填。告警 SMTP 密码。
ALERT_SMTP_PASSWORD=__CHANGE_ME__
# 必填。告警发件人邮箱。
ALERT_FROM=<ALERT_FROM>
# 必填。告警收件人邮箱。
ALERT_TO=<ALERT_TO>
# 可选。告警发件人显示名称。
ALERT_SENDER_NAME=Research Task Monitor

# ══════════════════════════════════════════════════════════════════════════
#  三、LLM 饮食建议生成（diet_survey）
# ══════════════════════════════════════════════════════════════════════════
# 主 API（OpenAI 兼容）
# 必填。LLM API 基础 URL（如 https://models.sjtu.edu.cn/api/v1）。
LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
# 必填。LLM 模型名称（如 deepseek-reasoner）。
LLM_MODEL_NAME=deepseek-reasoner
# 必填。主 API Key 列表，逗号分隔，支持双 Key 轮换。
# 如：sk-aaa111,sk-bbb222
LLM_API_KEYS=__CHANGE_ME__

# 备用 API（主 API 全部失败时自动切换）
# 可选。备用 API 基础 URL（如 https://api.deepseek.com）。
LLM_BACKUP_BASE_URL=https://api.deepseek.com
# 可选。备用模型名称（如 deepseek-v4-flash）。
LLM_BACKUP_MODEL_NAME=deepseek-v4-flash
# 可选。备用 API Key。
LLM_BACKUP_API_KEY=__CHANGE_ME__

# ══════════════════════════════════════════════════════════════════════════
#  四、问卷平台公共数据 API（WJX / wj.sjtu.edu.cn）
# ══════════════════════════════════════════════════════════════════════════
# 问卷「公共查询」令牌，取自问卷平台的 公共 API 地址
# 形如 https://wj.sjtu.edu.cn/api/v1/public/result/<TOKEN>/json
# 必填。
WJX_SURVEY_TOKEN=__CHANGE_ME__
# 可选。问卷分页大小。默认 50。
WJX_SURVEY_PAGE_SIZE=50

# 饮食问卷 Token。形如 https://wj.sjtu.edu.cn/api/v1/public/result/<TOKEN>/json
# 必填。
WJX_DIET_TOKEN=__CHANGE_ME__
# 可选。饮食问卷分页大小。默认 10。
WJX_DIET_PAGE_SIZE=10

# ══════════════════════════════════════════════════════════════════════════
#  五、备份（rclone，可选）
# ══════════════════════════════════════════════════════════════════════════
# 可选。rclone 远端配置名和路径（如 onedrive:opt-backup）。
RCLONE_REMOTE=onedrive:opt-backup
# 可选。备份日志路径。
BACKUP_LOG=/var/log/rclone-backup.log
