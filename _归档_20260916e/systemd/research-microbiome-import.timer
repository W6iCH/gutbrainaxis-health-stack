# ────────────────────────────────────────────────────────────────────────────
#  菌群数据导入定时器 — 每小时触发一次
#  周期来自 config/app.yaml → schedule.microbiome_import_minutes
# ────────────────────────────────────────────────────────────────────────────
[Unit]
Description=Research Microbiome Import Timer (every hour)

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
