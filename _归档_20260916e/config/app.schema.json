{
  "_README": [
    "统一配置 schema（app.yaml）—— 由 tools/appconfig.py 在**启动即校验**。",
    "flat 键为点分路径；type 支持 str|int|float|bool|path|url|email|enum|strlist。",
    "secret:true 的项允许为 \"${VAR}\" 形式（运行期解析），缺值只告警不阻断；",
    "其余 required:true 的项缺失或仍为占位符 → 校验失败并指出键位置。",
    "修改本文件后必须同步 config/app.yaml.example，二者版本需一致（version 字段）。"
  ],
  "version": 1,
  "fields": {
    "version": { "type": "int", "required": true, "min": 1 },

    "app.base_dir": { "type": "path", "required": true },
    "app.data_dir": { "type": "path", "required": true },
    "app.log_dir": { "type": "path", "required": true },
    "app.log_level": { "type": "enum", "required": true, "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
    "app.timezone": { "type": "str", "required": true },
    "app.scoring_version": { "type": "enum", "required": true, "enum": ["3.0-native-options", "3.0-native-ordinal", "2.0-official-rules"] },

    "site.domain": { "type": "str", "required": true },
    "site.public_scheme": { "type": "enum", "required": true, "enum": ["http", "https"] },
    "site.nginx_sites_dir": { "type": "path", "required": true },
    "site.nginx_enabled_dir": { "type": "path", "required": true },
    "site.nginx_log_dir": { "type": "path", "required": true },

    "services.survey_feedback.port": { "type": "int", "required": true, "min": 1, "max": 65535 },
    "services.survey_feedback.port_alt": { "type": "int", "required": false, "min": 0, "max": 65535 },
    "services.survey_feedback.dir": { "type": "str", "required": true },
    "services.survey_feedback.entry": { "type": "str", "required": true },
    "services.survey_feedback.enabled": { "type": "bool", "required": true },
    "services.diet_feedback.port": { "type": "int", "required": true, "min": 1, "max": 65535 },
    "services.diet_feedback.dir": { "type": "str", "required": true },
    "services.diet_feedback.entry": { "type": "str", "required": true },
    "services.diet_feedback.enabled": { "type": "bool", "required": true },
    "services.diet_webhook.port": { "type": "int", "required": true, "min": 1, "max": 65535 },
    "services.diet_webhook.dir": { "type": "str", "required": true },
    "services.diet_webhook.entry": { "type": "str", "required": true },
    "services.diet_webhook.enabled": { "type": "bool", "required": true },
    "services.diet_llm_queue.port": { "type": "int", "required": true, "min": 0, "max": 65535 },
    "services.diet_llm_queue.dir": { "type": "str", "required": true },
    "services.diet_llm_queue.entry": { "type": "str", "required": true },
    "services.diet_llm_queue.enabled": { "type": "bool", "required": true },
    "services.admin_console.port": { "type": "int", "required": true, "min": 1, "max": 65535 },
    "services.admin_console.host": { "type": "str", "required": true },
    "services.admin_console.dir": { "type": "str", "required": true },
    "services.admin_console.entry": { "type": "str", "required": true },
    "services.admin_console.enabled": { "type": "bool", "required": true },
    "services.data_dashboard.port": { "type": "int", "required": true, "min": 1, "max": 65535 },
    "services.data_dashboard.dir": { "type": "str", "required": true },
    "services.data_dashboard.entry": { "type": "str", "required": true },
    "services.data_dashboard.enabled": { "type": "bool", "required": true },

    "database.survey_db": { "type": "path", "required": true },
    "database.diet_db": { "type": "path", "required": true },
    "database.exercise_db": { "type": "path", "required": true },
    "database.microbiome_db": { "type": "path", "required": true },
    "database.roster": { "type": "path", "required": true },

    "smtp.use_ssl": { "type": "bool", "required": true },
    "smtp.host": { "type": "str", "required": true },
    "smtp.port": { "type": "int", "required": true, "min": 1, "max": 65535 },
    "smtp.ssl_host": { "type": "str", "required": false },
    "smtp.ssl_port": { "type": "int", "required": false, "min": 1, "max": 65535 },
    "smtp.username": { "type": "str", "required": true, "secret": true },
    "smtp.password": { "type": "str", "required": true, "secret": true },
    "smtp.sender_email": { "type": "email", "required": true, "secret": true },
    "smtp.sender_name": { "type": "str", "required": true },
    "smtp.admin_email": { "type": "email", "required": true, "secret": true },
    "smtp.cc_email": { "type": "email", "required": false },

    "alert.host": { "type": "str", "required": true },
    "alert.port": { "type": "int", "required": true, "min": 1, "max": 65535 },
    "alert.use_ssl": { "type": "bool", "required": true },
    "alert.username": { "type": "str", "required": true, "secret": true },
    "alert.password": { "type": "str", "required": true, "secret": true },
    "alert.sender_email": { "type": "email", "required": true, "secret": true },
    "alert.sender_name": { "type": "str", "required": true },
    "alert.to": { "type": "email", "required": true, "secret": true },
    "alert.cooldown_minutes": { "type": "int", "required": true, "min": 1 },

    "llm.primary.base_url": { "type": "url", "required": true },
    "llm.primary.model": { "type": "str", "required": true },
    "llm.primary.api_keys": { "type": "str", "required": true, "secret": true },
    "llm.primary.timeout_seconds": { "type": "int", "required": true, "min": 5 },
    "llm.primary.max_retries": { "type": "int", "required": true, "min": 0, "max": 10 },
    "llm.backup.enabled": { "type": "bool", "required": true },
    "llm.backup.base_url": { "type": "url", "required": false },
    "llm.backup.model": { "type": "str", "required": false },
    "llm.backup.api_key": { "type": "str", "required": false, "secret": true },
    "llm.backup.timeout_seconds": { "type": "int", "required": false, "min": 5 },

    "survey_platforms.scale.token": { "type": "str", "required": true, "secret": true },
    "survey_platforms.scale.page_size": { "type": "int", "required": true, "min": 1, "max": 500 },
    "survey_platforms.scale.fetch_interval_minutes": { "type": "int", "required": true, "min": 1 },
    "survey_platforms.diet.token": { "type": "str", "required": true, "secret": true },
    "survey_platforms.diet.page_size": { "type": "int", "required": true, "min": 1, "max": 500 },
    "survey_platforms.diet.fetch_interval_minutes": { "type": "int", "required": true, "min": 1 },
    "survey_platforms.exercise.token": { "type": "str", "required": true, "secret": true },
    "survey_platforms.exercise.page_size": { "type": "int", "required": true, "min": 1, "max": 500 },
    "survey_platforms.exercise.fetch_interval_minutes": { "type": "int", "required": true, "min": 1 },

    "schedule.survey_sync_minutes": { "type": "int", "required": true, "min": 5 },
    "schedule.diet_sync_minutes": { "type": "int", "required": true, "min": 5 },
    "schedule.exercise_sync_minutes": { "type": "int", "required": true, "min": 5 },
    "schedule.health_monitor_minutes": { "type": "int", "required": true, "min": 5 },
    "schedule.daily_report_at": { "type": "str", "required": true },
    "schedule.backup_at": { "type": "str", "required": true },
    "schedule.microbiome_import_minutes": { "type": "int", "required": true, "min": 1 },

    "backup.enabled": { "type": "bool", "required": true },
    "backup.dir": { "type": "path", "required": true },
    "backup.retention": { "type": "int", "required": true, "min": 1 },
    "backup.remote_enabled": { "type": "bool", "required": true },
    "backup.rclone_remote": { "type": "str", "required": false },
    "backup.rclone_log": { "type": "path", "required": true },

    "selfcheck.enabled": { "type": "bool", "required": true },
    "selfcheck.http_timeout_seconds": { "type": "int", "required": true, "min": 1 },
    "selfcheck.external_probe": { "type": "bool", "required": true },
    "selfcheck.external_probe_interval_seconds": { "type": "int", "required": true, "min": 1 },
    "selfcheck.db_write_test": { "type": "bool", "required": true },
    "selfcheck.min_free_disk_gb": { "type": "float", "required": true, "min": 0 },

    "microbiome.enabled": { "type": "bool", "required": true },
    "microbiome.dir": { "type": "path", "required": true },
    "microbiome.import_dir": { "type": "path", "required": true },
    "microbiome.allow_extra_columns": { "type": "bool", "required": true },
    "microbiome.omics_types.*": { "type": "str", "required": false }
  }
}
