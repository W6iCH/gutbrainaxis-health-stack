# ────────────────────────────────────────────────────────────────────────────
#  6) 问卷数据同步（定时运行，由 .timer 触发）
#  本 service 由 research-survey-sync.timer 调用
# ────────────────────────────────────────────────────────────────────────────
[Unit]
Description=Research Survey Sync Cron (triggered by timer)
Documentation=file://__APP_BASE__/docs/常见故障排查.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__SERVICE_USER__
WorkingDirectory=__APP_BASE__/sjtu_survey_pro
EnvironmentFile=-__ENV_FILE__
ExecStart=__VENV__ __APP_BASE__/sjtu_survey_pro/survey_sync_cron.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=research-survey-sync
