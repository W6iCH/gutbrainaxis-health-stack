# ────────────────────────────────────────────────────────────────────────────
#  3b) 量表问卷 Webhook 接收器   :9877（端口来自 services.survey_webhook.port）
#      问卷平台提交事件 → 立即拉取该条答卷 → 计分 → 入邮件队列
#      与 research-survey-sync.timer（每小时兜底拉取）并存：
#      webhook 为主（低延迟），定时为兜底（平台不支持回调/回调丢失时不丢数据）。
# ────────────────────────────────────────────────────────────────────────────
[Unit]
Description=Research Survey Webhook Listener (:9877)
Documentation=file://__APP_BASE__/docs/Webhook配置与验证.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__APP_BASE__/sjtu_survey_pro
EnvironmentFile=-__ENV_FILE__
ExecStart=__VENV__ __APP_BASE__/sjtu_survey_pro/survey_webhook_listener.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=research-survey-webhook

[Install]
WantedBy=multi-user.target
