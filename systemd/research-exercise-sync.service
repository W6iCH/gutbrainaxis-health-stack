# ────────────────────────────────────────────────────────────────────────────
#  5) 运动问卷同步（定时运行，由 .timer 触发）
#  本 service 由 research-exercise-sync.timer 定时调用，不单独 enable
# ────────────────────────────────────────────────────────────────────────────
[Unit]
Description=Research Exercise Survey Sync (triggered by timer)
Documentation=file://__APP_BASE__/docs/常见故障排查.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__SERVICE_USER__
WorkingDirectory=__APP_BASE__/exercise_survey
EnvironmentFile=-__ENV_FILE__
ExecStart=__VENV__ __APP_BASE__/exercise_survey/exercise_sync_cron.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=research-exercise-sync
